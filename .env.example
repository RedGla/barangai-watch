# Every setting the app reads. Copy to .env (git-ignored) for local use; never commit the real .env or paste
# its values into chat. deploy/start-local.ps1 reads only the Cloudflare, geocoder contact and Google keys
# from .env, and sets the local database, storage and checker itself.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost/barangai
PRIVATE_MEDIA_DIR=./private_media
# Local files for development; use supabase for Render's ephemeral filesystem.
MEDIA_STORAGE=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=incident-photos
# Set only when serving a built website from FastAPI (Render uses /app/static).
STATIC_SITE_DIR=
COOKIE_SECURE=false
MAX_IMAGE_BYTES=5000000
# Cap multipart bodies before parsing; configure the ingress/proxy request limit to 6000000 bytes or less as well.
MAX_REQUEST_BYTES=6000000
# Optional Workers AI: photo descriptions and chatbot guidance. Use a Workers Free account; keep the token
# server-side. The account ID is the 32-character code in the dashboard URL; the token comes from
# Manage Account > Account API Tokens, with the Workers AI > Edit permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_TOKEN=
# Optional: a different vision model (default @cf/mistralai/mistral-small-3.1-24b-instruct).
CLOUDFLARE_VISION_MODEL=
# Optional category checker and duplicate embeddings (MobileCLIP2-S0, ONNX). The launcher and the Render image
# set these; locally point CHECKER_MODEL_DIR at apps/api/models/mobileclip2-s0.
CHECKER_MODEL_DIR=
CHECKER_CONFIDENCE_THRESHOLD=0.5
VALIDATED_EMBEDDING_MODEL_VERSION=
# Optional street names for report pins via OpenStreetMap Nominatim; add a contact email for its usage policy.
GEOCODER=
GEOCODER_CONTACT=
# Optional resident Google sign-in. Configure the exact public /api callback
# (locally http://127.0.0.1:8000/api/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
