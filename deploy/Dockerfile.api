FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml ./
COPY barangai ./barangai
COPY alembic.ini ./
COPY migrations ./migrations
ARG INSTALL_VISION=false
RUN if [ "$INSTALL_VISION" = "true" ]; then pip install --no-cache-dir '.[vision]'; else pip install --no-cache-dir .; fi \
    && useradd --uid 10001 --create-home app && mkdir -p /data/private_media && chown -R app:app /data
USER app
EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && uvicorn barangai.main:app --host 0.0.0.0 --port 8000"]
