# Save as deploy/.env on the deployment host; never commit that file.
BARANGAI_DOMAIN=your-hostname.example
POSTGRES_PASSWORD=replace-with-a-long-random-password
# URL-encode password characters in DATABASE_URL.
DATABASE_URL=postgresql+psycopg2://barangai:replace-with-a-long-random-password@db:5432/barangai
# Set only after the five-class model is trained, reviewed, and benchmarked.
INSTALL_VISION=false
MODEL_CHECKPOINT=
MODEL_APPROVED_SHA256=
MODEL_CONFIDENCE_THRESHOLD=
VALIDATED_EMBEDDING_MODEL_VERSION=
